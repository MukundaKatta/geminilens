# Copy to .env and fill in. Do not commit the real .env.

# Google Cloud / Vertex AI
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=TRUE
# Gemini 3 model id. gemini-3-pro is current; gemini-3.1-pro is the newer revision.
TRIAGE_MODEL=gemini-3-pro

# Dynatrace remote MCP
# Environment URL, for example https://abc12345.apps.dynatrace.com
DT_ENVIRONMENT=https://YOUR-ENV.apps.dynatrace.com
# Platform Token. Gateway scopes: mcp-gateway:servers:invoke, mcp-gateway:servers:read.
# Also add the tool scopes you will use, for example storage:buckets:read,
# storage:logs:read, storage:entities:read, davis-copilot:nl2dql:execute. The token
# only works within your own Dynatrace permission scope.
DT_PLATFORM_TOKEN=REPLACE_WITH_YOUR_DYNATRACE_PLATFORM_TOKEN

# Optional: GeminiLens closed-loop exporter (ship the agent's own traces back to
# Dynatrace as logs). This is a SEPARATE credential from the MCP gateway above.
# DT_ENV_URL is the classic environment URL (.live.), and DT_API_TOKEN needs the
# logs.ingest scope. Only needed if you enable the DynatraceExporter on_trace hook.
DT_ENV_URL=https://YOUR-ENV.live.dynatrace.com
DT_API_TOKEN=REPLACE_WITH_YOUR_DYNATRACE_LOGS_INGEST_TOKEN
